{
  "name": "software-factory",
  "version": "0.1.0",
  "private": true,
  "description": "The Software Factory — an autonomous software-production system whose value rests on independent verification, deterministic policy, and human control.",
  "type": "module",
  "packageManager": "pnpm@10.8.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "ci": "pnpm lint && pnpm typecheck && pnpm lint:deps && pnpm schemas:check && pnpm capabilities:check && pnpm ddl:check && pnpm test && pnpm test:acceptance && pnpm test:invariants && pnpm test:redteam",
    "lint": "eslint .",
    "lint:deps": "depcruise --config .dependency-cruiser.json .",
    "typecheck": "tsc --build --verbose",
    "schemas": "pnpm typecheck && node tools/export-schemas.ts",
    "schemas:check": "pnpm typecheck && node tools/export-schemas.ts --check",
    "capabilities": "node tools/generate-capabilities.ts",
    "capabilities:check": "node tools/generate-capabilities.ts --check",
    "ddl:sync": "node tools/extract-pack-ddl.ts",
    "ddl:check": "node tools/extract-pack-ddl.ts --check",
    "ddl:oracle": "bash tools/run-pack-ddl-oracle.sh",
    "test": "vitest run tests/unit",
    "test:acceptance": "vitest run tests/acceptance --passWithNoTests",
    "test:invariants": "vitest run tests/invariants --passWithNoTests",
    "test:redteam": "vitest run tests/redteam --passWithNoTests",
    "test:fault": "vitest run tests/fault --passWithNoTests",
    "test:concurrency": "vitest run tests/concurrency --passWithNoTests",
    "test:e2e": "vitest run tests/e2e --passWithNoTests",
    "test:e2e:browser": "playwright test",
    "test:mutation": "vitest run tests/invariants --mutation",
    "test:mutation:artefacts": "node tools/mutate-artefacts.ts",
    "test:mutation:api": "node tools/mutate-api.ts",
    "test:mutation:broker": "node tools/mutate-broker.ts",
    "test:mutation:credentials": "node tools/mutate-credentials.ts",
    "test:mutation:gateway": "node tools/mutate-gateway.ts",
    "test:mutation:isolation": "node tools/mutate-isolation.ts",
    "test:mutation:orchestrator": "node tools/mutate-orchestrator.ts",
    "test:mutation:projections": "node tools/mutate-projections.ts",
    "test:mutation:operational-surface": "node tools/mutate-operational-surface.ts",
    "coverage-check": "node tools/coverage-check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.15.0",
    "@factory/approvals": "workspace:*",
    "@factory/artefacts": "workspace:*",
    "@factory/broker": "workspace:*",
    "@factory/contracts": "workspace:*",
    "@factory/core": "workspace:*",
    "@factory/credentials": "workspace:*",
    "@factory/db": "workspace:*",
    "@factory/definition": "workspace:*",
    "@factory/eventlog": "workspace:*",
    "@factory/gateway": "workspace:*",
    "@factory/isolation": "workspace:*",
    "@factory/orchestrator": "workspace:*",
    "@factory/policy": "workspace:*",
    "@factory/projections": "workspace:*",
    "@factory/state": "workspace:*",
    "@playwright/test": "1.63.0",
    "@types/js-yaml": "4.0.9",
    "@types/node": "22.9.0",
    "dependency-cruiser": "18.7.2",
    "eslint": "9.15.0",
    "fast-check": "3.22.0",
    "js-yaml": "4.1.0",
    "typescript": "5.6.3",
    "typescript-eslint": "8.15.0",
    "vitest": "2.1.5",
    "zod": "3.23.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
