{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scheduler.artefact-ref.json",
  "title": "scheduler.artefact-ref",
  "description": "Contract from pack 03 §3 scheduling.",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "uri": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "bytes": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "kind",
    "uri"
  ],
  "additionalProperties": false
}
