{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gateway.request.json",
  "title": "gateway.request",
  "description": "Contract from pack 03 §3 model gateway.",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "minLength": 1
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "nodeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "attempt": {
      "type": "integer",
      "minimum": 0
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "system",
              "user",
              "assistant",
              "tool"
            ]
          },
          "content": {
            "type": "string"
          },
          "toolCallId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "role",
          "content"
        ],
        "additionalProperties": false
      }
    },
    "system": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "body": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "required": [
          "id",
          "body"
        ],
        "additionalProperties": false
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "inputSchema": {}
        },
        "required": [
          "name",
          "description",
          "inputSchema"
        ],
        "additionalProperties": false
      }
    },
    "responseFormat": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "json-schema"
        },
        "schema": {},
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "schema",
        "name"
      ],
      "additionalProperties": false
    },
    "routingHints": {
      "type": "object",
      "properties": {
        "complexity": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        }
      },
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "properties": {
        "maxUsdMicros": {
          "type": "integer",
          "minimum": 0
        },
        "maxTokens": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "cachePolicy": {
      "type": "string",
      "enum": [
        "prefix",
        "none"
      ]
    }
  },
  "required": [
    "role",
    "taskId",
    "nodeId",
    "attempt",
    "messages"
  ],
  "additionalProperties": false
}
