{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scheduler.effective-grant.json",
  "title": "scheduler.effective-grant",
  "description": "Contract from pack 03 §3 scheduling.",
  "type": "object",
  "properties": {
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "scopes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "resourceScope": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string"
        },
        "paths": {
          "type": "object",
          "properties": {
            "writeGlobs": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "denyGlobs": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "capabilities",
    "scopes"
  ],
  "additionalProperties": false
}
