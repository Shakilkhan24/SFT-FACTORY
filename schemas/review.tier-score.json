{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review.tier-score.json",
  "title": "review.tier-score",
  "description": "Contract from pack 03 §3 review.",
  "type": "object",
  "properties": {
    "tier": {
      "type": "string",
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3",
        "R4"
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "score": {
      "type": "number"
    }
  },
  "required": [
    "tier",
    "reasons",
    "score"
  ],
  "additionalProperties": false
}
