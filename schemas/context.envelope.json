{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "context.envelope.json",
  "title": "context.envelope",
  "description": "Contract from pack 03 §3 context.",
  "type": "object",
  "properties": {
    "envelopeId": {
      "type": "string",
      "minLength": 1
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "trust": {
            "type": "string",
            "enum": [
              "trusted",
              "untrusted-content",
              "derived"
            ]
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "version",
          "sha256",
          "trust",
          "bytes"
        ],
        "additionalProperties": false
      }
    },
    "resolvedContextSha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "truncations": {
      "type": "array",
      "items": {
        "not": {}
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "expected": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "expected",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "budget": {
      "type": "object",
      "properties": {
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "bytes",
        "limit"
      ],
      "additionalProperties": false
    },
    "rendered": {
      "type": "string"
    }
  },
  "required": [
    "envelopeId",
    "items",
    "resolvedContextSha256",
    "truncations",
    "gaps",
    "budget",
    "rendered"
  ],
  "additionalProperties": false
}
