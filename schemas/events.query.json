{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "events.query.json",
  "title": "events.query",
  "description": "Contract from pack 03 §3 event log.",
  "type": "object",
  "properties": {
    "aggregate": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "task",
            "node",
            "approval",
            "definition",
            "run",
            "change",
            "system"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "types": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "afterSeq": {
      "type": "integer",
      "minimum": 0
    },
    "limit": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    }
  },
  "additionalProperties": false
}
