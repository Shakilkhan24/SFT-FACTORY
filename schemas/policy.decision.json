{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "policy.decision.json",
  "title": "policy.decision",
  "description": "Contract from pack 03 §3 policy.",
  "type": "object",
  "properties": {
    "outcome": {
      "type": "string",
      "enum": [
        "ALLOW",
        "DENY",
        "REQUIRE_APPROVAL",
        "ESCALATE"
      ]
    },
    "ruleIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "bundleSha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "requiredApproval": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "const": "security"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "outcome",
    "ruleIds",
    "reason",
    "bundleSha256"
  ],
  "additionalProperties": false
}
