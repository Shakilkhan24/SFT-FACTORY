{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "events.envelope.json",
  "title": "events.envelope",
  "description": "Contract from pack 03 §3 event log.",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string"
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "occurredAt": {
      "type": "string"
    },
    "eventType": {
      "type": "string",
      "enum": [
        "intent.recorded",
        "intent.rejected",
        "request.triaged",
        "request.classified",
        "spec.refined",
        "spec.accepted",
        "spec.escalated",
        "spec.criteriaAdded",
        "plan.produced",
        "plan.validated",
        "plan.rejected",
        "plan.replanned",
        "node.ready",
        "node.leased",
        "node.executionStarted",
        "stage.completed",
        "stage.failed",
        "stage.incomplete",
        "tool.invoked",
        "tool.denied",
        "tool.failed",
        "model.requested",
        "model.failed",
        "model.failedOver",
        "gate.started",
        "gate.passed",
        "gate.failed",
        "verification.blocked",
        "calibration.completed",
        "review.queued",
        "review.opened",
        "review.commentAdded",
        "review.approved",
        "review.rejected",
        "review.deferred",
        "review.escalated",
        "change.merged",
        "change.mergeFailed",
        "release.deployed",
        "release.failed",
        "release.rolledBack",
        "policy.allowed",
        "policy.denied",
        "policy.escalated",
        "approval.requested",
        "approval.granted",
        "approval.expired",
        "approval.revoked",
        "autonomy.promoted",
        "autonomy.revoked",
        "proposal.created",
        "proposal.evaluated",
        "proposal.approved",
        "proposal.rejected",
        "harness.changeRolledBack",
        "definition.applied",
        "definition.driftDetected",
        "environment.provisioned",
        "environment.cleaned",
        "budget.exhausted",
        "run.replayed",
        "webhook.received",
        "webhook.rejected",
        "oracle.constructed",
        "oracle.admitted",
        "oracle.admissionFailed",
        "patch.extracted",
        "patch.rejected",
        "gate.weakeningDetected",
        "change.opened",
        "change.updated",
        "credential.minted",
        "credential.revoked",
        "net.egress.denied",
        "net.egress.summary",
        "kill.switch.engaged",
        "kill.switch.released",
        "node.duplicateExecution"
      ]
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 0
    },
    "aggregate": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "task",
            "node",
            "approval",
            "definition",
            "run",
            "change",
            "system"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "kind",
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "causationId": {
      "type": "string",
      "minLength": 1
    },
    "actor": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "human",
            "agent",
            "system",
            "integration"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "instanceId": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "provider",
            "model"
          ],
          "additionalProperties": false
        },
        "harness": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "name",
            "version"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    "authority": {
      "type": "object",
      "properties": {
        "basis": {
          "type": "string",
          "enum": [
            "human-access-point",
            "policy-decision",
            "approval",
            "system-rule"
          ]
        },
        "policyDecisionId": {
          "type": "string",
          "minLength": 1
        },
        "approvalId": {
          "type": "string",
          "minLength": 1
        },
        "autonomyLevel": {
          "anyOf": [
            {
              "const": 0
            },
            {
              "const": 1
            },
            {
              "const": 2
            },
            {
              "const": 3
            },
            {
              "const": 4
            }
          ]
        },
        "violation": {
          "type": "boolean"
        }
      },
      "required": [
        "basis"
      ],
      "additionalProperties": false
    },
    "subject": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "payload": {},
    "context": {
      "type": "object",
      "properties": {
        "envelopeId": {
          "type": "string",
          "minLength": 1
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            },
            "required": [
              "id",
              "version",
              "sha256"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "resolvedContextSha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "redaction": {
      "type": "object",
      "properties": {
        "applied": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "policyRef": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "applied"
      ],
      "additionalProperties": false
    },
    "costUsdMicros": {
      "type": "integer",
      "minimum": 0
    },
    "durationMs": {
      "type": "integer",
      "minimum": 0
    },
    "prevHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "required": [
    "eventId",
    "seq",
    "occurredAt",
    "eventType",
    "schemaVersion",
    "aggregate",
    "correlationId",
    "actor",
    "authority",
    "subject",
    "payload",
    "context",
    "redaction",
    "hash"
  ],
  "additionalProperties": false
}
