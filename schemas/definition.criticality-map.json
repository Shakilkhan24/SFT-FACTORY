{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "definition.criticality-map.json",
  "title": "definition.criticality-map",
  "description": "Contract from pack 03 §4.8.",
  "type": "object",
  "properties": {
    "apiVersion": {
      "const": "factory/v1"
    },
    "kind": {
      "const": "CriticalityMap"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "glob": {
                "type": "string",
                "minLength": 1
              },
              "tier": {
                "type": "string",
                "enum": [
                  "R0",
                  "R1",
                  "R2",
                  "R3",
                  "R4"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "glob",
              "tier",
              "reason"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "default": {
          "type": "string",
          "enum": [
            "R0",
            "R1",
            "R2",
            "R3",
            "R4"
          ]
        },
        "dataClasses": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "glob": {
                "type": "string",
                "minLength": 1
              },
              "class": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "glob",
              "class"
            ],
            "additionalProperties": false
          },
          "default": []
        }
      },
      "required": [
        "default"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "additionalProperties": false
}
