{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "events.new-event.json",
  "title": "events.new-event",
  "description": "Contract from pack 03 §3 event log.",
  "type": "object",
  "properties": {
    "eventType": {
      "type": "string",
      "minLength": 1
    },
    "aggregate": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "task",
            "node",
            "approval",
            "definition",
            "run",
            "change",
            "system"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "kind",
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "causationId": {
      "type": "string",
      "minLength": 1
    },
    "actor": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "human",
            "agent",
            "system",
            "integration"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "instanceId": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "provider",
            "model"
          ],
          "additionalProperties": false
        },
        "harness": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "name",
            "version"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    "authority": {
      "type": "object",
      "properties": {
        "basis": {
          "type": "string",
          "enum": [
            "human-access-point",
            "policy-decision",
            "approval",
            "system-rule"
          ]
        },
        "policyDecisionId": {
          "type": "string",
          "minLength": 1
        },
        "approvalId": {
          "type": "string",
          "minLength": 1
        },
        "autonomyLevel": {
          "anyOf": [
            {
              "const": 0
            },
            {
              "const": 1
            },
            {
              "const": 2
            },
            {
              "const": 3
            },
            {
              "const": 4
            }
          ]
        },
        "violation": {
          "type": "boolean"
        }
      },
      "required": [
        "basis"
      ],
      "additionalProperties": false
    },
    "subject": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "default": {}
    },
    "payload": {},
    "context": {
      "type": "object",
      "properties": {
        "envelopeId": {
          "type": "string",
          "minLength": 1
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            },
            "required": [
              "id",
              "version",
              "sha256"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "resolvedContextSha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false,
      "default": {
        "items": []
      }
    },
    "costUsdMicros": {
      "type": "integer",
      "minimum": 0
    },
    "durationMs": {
      "type": "integer",
      "minimum": 0
    },
    "bumpsVersion": {
      "type": "boolean"
    }
  },
  "required": [
    "eventType",
    "aggregate",
    "correlationId",
    "actor",
    "authority",
    "payload"
  ],
  "additionalProperties": false
}
