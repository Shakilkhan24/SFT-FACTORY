{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "context.repo-scope.json",
  "title": "context.repo-scope",
  "description": "Contract from pack 03 §3 context.",
  "type": "object",
  "properties": {
    "repo": {
      "type": "string",
      "minLength": 1
    },
    "defaultBranch": {
      "type": "string",
      "minLength": 1
    },
    "paths": {
      "type": "object",
      "properties": {
        "src": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "docs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "contextFiles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    }
  },
  "required": [
    "repo",
    "defaultBranch"
  ],
  "additionalProperties": false
}
