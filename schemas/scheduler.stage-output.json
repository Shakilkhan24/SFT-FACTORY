{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scheduler.stage-output.json",
  "title": "scheduler.stage-output",
  "description": "Contract from pack 03 §3 scheduling.",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "success",
        "failure",
        "incomplete"
      ]
    },
    "artefacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "uri": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "kind",
          "uri"
        ],
        "additionalProperties": false
      }
    },
    "verification": {},
    "failure": {
      "type": "object",
      "properties": {
        "class": {
          "type": "string",
          "enum": [
            "model.reasoning",
            "model.capability",
            "workflow.composition",
            "context.insufficient",
            "verification.failure",
            "environment.failure",
            "policy.denied",
            "budget.exhausted",
            "tool.unavailable",
            "unknown"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "retriable": {
          "type": "boolean"
        }
      },
      "required": [
        "class",
        "reason",
        "retriable"
      ],
      "additionalProperties": false
    },
    "nextState": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "not": {}
    }
  },
  "required": [
    "status",
    "artefacts"
  ],
  "additionalProperties": false
}
