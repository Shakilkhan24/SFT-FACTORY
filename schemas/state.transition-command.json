{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "state.transition-command.json",
  "title": "state.transition-command",
  "description": "Contract from pack 03 §3 state.",
  "type": "object",
  "properties": {
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "to": {
      "type": "string",
      "enum": [
        "DRAFT",
        "TRIAGED",
        "REFINED",
        "PLANNED",
        "QUEUED",
        "RUNNING",
        "VERIFYING",
        "AWAITING_REVIEW",
        "AWAITING_APPROVAL",
        "APPROVED",
        "MERGING",
        "MERGED",
        "DEPLOYING",
        "DEPLOYED",
        "REJECTED",
        "FAILED",
        "ABANDONED",
        "INCOMPLETE",
        "ESCALATED"
      ]
    },
    "trigger": {
      "type": "string",
      "minLength": 1
    },
    "actor": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "human",
            "agent",
            "system",
            "integration"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "instanceId": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "provider",
            "model"
          ],
          "additionalProperties": false
        },
        "harness": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "name",
            "version"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    "authority": {
      "type": "object",
      "properties": {
        "basis": {
          "type": "string",
          "enum": [
            "human-access-point",
            "policy-decision",
            "approval",
            "system-rule"
          ]
        },
        "policyDecisionId": {
          "type": "string",
          "minLength": 1
        },
        "approvalId": {
          "type": "string",
          "minLength": 1
        },
        "autonomyLevel": {
          "anyOf": [
            {
              "const": 0
            },
            {
              "const": 1
            },
            {
              "const": 2
            },
            {
              "const": 3
            },
            {
              "const": 4
            }
          ]
        },
        "violation": {
          "type": "boolean"
        }
      },
      "required": [
        "basis"
      ],
      "additionalProperties": false
    },
    "expectedVersion": {
      "type": "integer",
      "minimum": 0
    },
    "payload": {}
  },
  "required": [
    "taskId",
    "to",
    "trigger",
    "actor",
    "authority",
    "expectedVersion"
  ],
  "additionalProperties": false
}
