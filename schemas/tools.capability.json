      "required": [
        "class",
        "reversible",
        "external"
      ],
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "resourcePattern": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "required",
        "resourcePattern",
        "environment"
