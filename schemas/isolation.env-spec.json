{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "isolation.env-spec.json",
  "title": "isolation.env-spec",
  "description": "Contract from pack 03 §3 isolation.",
  "type": "object",
  "properties": {
    "tier": {
      "type": "string",
      "enum": [
        "T1",
        "T2"
      ]
    },
    "image": {
      "type": "string",
      "minLength": 1
    },
    "network": {
      "type": "object",
      "properties": {
        "egress": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "resources": {
      "type": "object",
      "properties": {
        "cpus": {
          "type": "integer",
          "minimum": 0
        },
        "memoryMb": {
          "type": "integer",
          "minimum": 0
        },
        "pids": {
          "type": "integer",
          "minimum": 0
        },
        "wallClockSeconds": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "env": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": [
    "tier",
    "image"
  ],
  "additionalProperties": false
}
