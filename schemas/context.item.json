{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "context.item.json",
  "title": "context.item",
  "description": "Contract from pack 03 §3 context.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "trust": {
      "type": "string",
      "enum": [
        "trusted",
        "untrusted-content",
        "derived"
      ]
    },
    "bytes": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "id",
    "version",
    "sha256",
    "trust",
    "bytes"
  ],
  "additionalProperties": false
}
