{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "verify.gate-report.json",
  "title": "verify.gate-report",
  "description": "Contract from pack 03 §3 verification.",
  "type": "object",
  "properties": {
    "gateReportId": {
      "type": "string",
      "minLength": 1
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "headSha": {
      "type": "string",
      "minLength": 1
    },
    "tier": {
      "type": "string",
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3",
        "R4"
      ]
    },
    "passed": {
      "type": "boolean"
    },
    "report": {},
    "reportSha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "required": [
    "gateReportId",
    "taskId",
    "headSha",
    "tier",
    "passed",
    "report",
    "reportSha256"
  ],
  "additionalProperties": false
}
