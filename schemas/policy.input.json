{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "policy.input.json",
  "title": "policy.input",
  "description": "Contract from pack 03 §3 policy.",
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "minLength": 1
    },
    "capabilityId": {
      "type": "string",
      "minLength": 1
    },
    "effectClass": {
      "type": "string",
      "enum": [
        "E0",
        "E1",
        "E2",
        "E3",
        "E4"
      ]
    },
    "actor": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "human",
            "agent",
            "system",
            "integration"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "instanceId": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "provider",
            "model"
          ],
          "additionalProperties": false
        },
        "harness": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "name",
            "version"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "workflow": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "type": "string",
      "minLength": 1
    },
    "autonomy": {
      "anyOf": [
        {
          "const": 0
        },
        {
          "const": 1
        },
        {
          "const": 2
        },
        {
          "const": 3
        },
        {
          "const": 4
        }
      ]
    },
    "tier": {
      "type": "string",
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3",
        "R4"
      ]
    },
    "resource": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "host": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "ref"
      ],
      "additionalProperties": false
    },
    "approvalId": {
      "type": "string",
      "minLength": 1
    },
    "args": {},
    "priorDenials": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "effectClass": {
            "type": "string",
            "enum": [
              "E0",
              "E1",
              "E2",
              "E3",
              "E4"
            ]
          },
          "resourceKey": {
            "type": "string",
            "minLength": 1
          },
          "capabilityId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "effectClass",
          "resourceKey",
          "capabilityId"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "action",
    "actor",
    "workflow",
    "autonomy"
  ],
  "additionalProperties": false
}
