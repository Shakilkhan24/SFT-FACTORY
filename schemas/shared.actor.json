{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shared.actor.json",
  "title": "shared.actor",
  "description": "Contract from pack 03 §3 shared.",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "human",
        "agent",
        "system",
        "integration"
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "instanceId": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "provider",
        "model"
      ],
      "additionalProperties": false
    },
    "harness": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "kind",
    "id"
  ],
  "additionalProperties": false
}
