{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review.panel-result.json",
  "title": "review.panel-result",
  "description": "Contract from pack 03 §3 review.",
  "type": "object",
  "properties": {
    "outcome": {
      "type": "string",
      "enum": [
        "approve",
        "reject",
        "escalate"
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "blockingReviewers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "outcome",
    "reasons",
    "blockingReviewers"
  ],
  "additionalProperties": false
}
