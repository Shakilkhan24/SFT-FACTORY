{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tools.invocation-context.json",
  "title": "tools.invocation-context",
  "description": "Contract from pack 03 §3 tools.",
  "type": "object",
  "properties": {
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "nodeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "attempt": {
      "type": "integer",
      "minimum": 0
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "actor": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "human",
            "agent",
            "system",
            "integration"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "instanceId": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "provider",
            "model"
          ],
          "additionalProperties": false
        },
        "harness": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "name",
            "version"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    "workflow": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "type": "string",
      "minLength": 1
    },
    "autonomy": {
      "anyOf": [
        {
          "const": 0
        },
        {
          "const": 1
        },
        {
          "const": 2
        },
        {
          "const": 3
        },
        {
          "const": 4
        }
      ]
    },
    "tier": {
      "type": "string",
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3",
        "R4"
      ]
    }
  },
  "required": [
    "taskId",
    "nodeId",
    "attempt",
    "runId",
    "actor",
    "workflow",
    "stage",
    "autonomy"
  ],
  "additionalProperties": false
}
